<Window x:Class="FoldZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoldZip"
        Width="1120" Height="760" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 命令栏按钮：无边框圆角，资源管理器风格 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮：贴近系统默认行为 -->
        <Style x:Key="CapBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.TitleHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.TitlePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapBtnClose" TargetType="Button" BasedOn="{StaticResource CapBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 资源管理器式行交互：无斑马纹，浅悬停，蓝选中 -->
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.HoverBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- 名称列：图标 + 文件名 -->
        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding IconText}" FontSize="14"
                           Margin="0,0,9,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDir}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           ToolTip="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PackedCell">
            <TextBlock Text="{Binding PackedText}" TextAlignment="Right" VerticalAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" Margin="0">

        <!-- 标题栏：与窗口同色，融入系统 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.TitleBg}" Height="38">
            <DockPanel Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FoldZip" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Text="v0.1.0" FontSize="11"
                               Foreground="{DynamicResource Brush.SubText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CapBtn}" Content="&#xE921;" Click="BtnMin_Click"/>
                    <Button x:Name="BtnMax" Style="{StaticResource CapBtn}" Content="&#xE922;" Click="BtnMax_Click"/>
                    <Button Style="{StaticResource CapBtnClose}" Content="&#xE8BB;" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="12,4,12,12">

            <!-- 命令栏：无边框图标按钮 -->
            <WrapPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <Button x:Name="BtnNew" Click="BtnNew_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="新建压缩包" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnOpen" Click="BtnOpen_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="打开压缩包" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSave" Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="保存压缩包" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="22" Background="{DynamicResource Brush.Border}" Margin="8,9,10,9"/>
                <Button x:Name="BtnAddFiles" Click="BtnAddFiles_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAddFolder" Click="BtnAddFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRemove" Click="BtnRemove_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="移除选中" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="22" Background="{DynamicResource Brush.Border}" Margin="8,9,10,9"/>
                <Button x:Name="BtnExtractAll" Click="BtnExtractAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="解压到…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnExtractSelected" Click="BtnExtractSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="解压选中" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="22" Background="{DynamicResource Brush.Border}" Margin="8,9,10,9"/>
                <Button x:Name="BtnTheme" Click="BtnTheme_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="切换主题" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAbout" Click="BtnAbout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="关于" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- 中部：条目列表 + 空状态提示 -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <ListView x:Name="ArchiveList"
                              SelectionMode="Extended"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="ArchiveList_SelectionChanged">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="解压选中…" Click="BtnExtractSelected_Click"/>
                                <MenuItem Header="复制名称" Click="MenuCopyName_Click"/>
                                <Separator/>
                                <MenuItem Header="移除选中" Click="BtnRemove_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="460" CellTemplate="{StaticResource NameCell}">
                                    <GridViewColumnHeader Tag="Name" Click="ColHeader_Click">名称</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="96" CellTemplate="{StaticResource SizeCell}">
                                    <GridViewColumnHeader Tag="Size" Click="ColHeader_Click">大小</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="96" CellTemplate="{StaticResource PackedCell}">
                                    <GridViewColumnHeader Tag="Packed" Click="ColHeader_Click">压缩后</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="150" DisplayMemberBinding="{Binding ModifiedText}">
                                    <GridViewColumnHeader Tag="Modified" Click="ColHeader_Click">修改时间</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding MethodText}">
                                    <GridViewColumnHeader Tag="Method" Click="ColHeader_Click">方式</GridViewColumnHeader>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel x:Name="EmptyHint" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="把文件或压缩包拖到这里" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="或使用上方「新建压缩包 / 打开压缩包」" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部：进度 + 状态 + 日志（常驻） -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel>
                    <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100"
                                 Background="{DynamicResource Brush.HoverBg}"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 BorderThickness="0"/>
                    <DockPanel Margin="2,8,0,0">
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"
                                   Foreground="{DynamicResource Brush.SubText}"/>
                        <TextBlock x:Name="ProgressText" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="2,10,0,6">
                        <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancel" Click="BtnCancel_Click">
                                <TextBlock Text="取消当前操作"/>
                            </Button>
                            <Button x:Name="BtnCopyLog" Click="BtnCopyLog_Click">
                                <TextBlock Text="复制全部日志"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="LogBox" Height="110"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource Brush.LogBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             BorderThickness="1" Padding="8,6"
                             Text="日志将在此显示。操作失败时的错误信息会常驻在这里，不会自动消失。"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
