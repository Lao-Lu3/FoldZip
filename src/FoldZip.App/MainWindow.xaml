<Window x:Class="FoldZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoldZip"
        Width="1120" Height="760" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 常规按钮 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏小按钮 -->
        <Style x:Key="CapBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.TitleHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.TitlePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapBtnClose" TargetType="Button" BasedOn="{StaticResource CapBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Brush.AltRow}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.HoverBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.HeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 名称列：图标 + 文件名 -->
        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding IconText}" FontSize="14"
                           Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDir}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           ToolTip="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 右对齐数值列 -->
        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="PackedCell">
            <TextBlock Text="{Binding PackedText}" TextAlignment="Right" VerticalAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" Margin="0">

        <!-- 自绘标题栏：与主题融为一体 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.TitleBg}" Height="40">
            <DockPanel Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#33FFFFFF" CornerRadius="6" Padding="5,2" VerticalAlignment="Center">
                        <TextBlock Text="FZ" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="FoldZip" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#26FFFFFF" CornerRadius="5" Padding="6,1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v0.1.0" FontSize="11" Foreground="#E6FFFFFF"/>
                    </Border>
                    <TextBlock Text="免费开源的 Windows 压缩工具 · zip / tar / gz / 7z"
                               Foreground="#B8FFFFFF" FontSize="11.5" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CapBtn}" Content="&#xE921;" Click="BtnMin_Click"/>
                    <Button x:Name="BtnMax" Style="{StaticResource CapBtn}" Content="&#xE922;" Click="BtnMax_Click"/>
                    <Button Style="{StaticResource CapBtnClose}" Content="&#xE8BB;" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="16,12,16,14">

            <!-- 工具栏：按功能分组 -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="10" Margin="0,0,0,10">
                <WrapPanel>
                    <Button x:Name="BtnNew" Content="新建压缩包" Click="BtnNew_Click"/>
                    <Button x:Name="BtnOpen" Content="打开压缩包" Click="BtnOpen_Click"/>
                    <Button x:Name="BtnSave" Content="保存压缩包" Click="BtnSave_Click"/>
                    <Border Width="1" Height="24" Background="{DynamicResource Brush.Border}" Margin="6,7,14,7"/>
                    <Button x:Name="BtnAddFiles" Content="添加文件" Click="BtnAddFiles_Click"/>
                    <Button x:Name="BtnAddFolder" Content="添加文件夹" Click="BtnAddFolder_Click"/>
                    <Button x:Name="BtnRemove" Content="移除选中" Click="BtnRemove_Click"/>
                    <Border Width="1" Height="24" Background="{DynamicResource Brush.Border}" Margin="6,7,14,7"/>
                    <Button x:Name="BtnExtractAll" Content="解压到…" Click="BtnExtractAll_Click"/>
                    <Button x:Name="BtnExtractSelected" Content="解压选中" Click="BtnExtractSelected_Click"/>
                    <Border Width="1" Height="24" Background="{DynamicResource Brush.Border}" Margin="6,7,14,7"/>
                    <Button x:Name="BtnTheme" Content="切换主题" Click="BtnTheme_Click"/>
                    <Button x:Name="BtnAbout" Content="关于" Click="BtnAbout_Click" MinWidth="64"/>
                </WrapPanel>
            </Border>

            <!-- 中部：条目列表 + 空状态提示 -->
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10"
                    ClipToBounds="True">
                <Grid>
                    <ListView x:Name="ArchiveList"
                              SelectionMode="Extended"
                              AlternationCount="2"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionChanged="ArchiveList_SelectionChanged">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="解压选中…" Click="BtnExtractSelected_Click"/>
                                <MenuItem Header="复制名称" Click="MenuCopyName_Click"/>
                                <Separator/>
                                <MenuItem Header="移除选中" Click="BtnRemove_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="460" CellTemplate="{StaticResource NameCell}">
                                    <GridViewColumnHeader Tag="Name" Click="ColHeader_Click">名称</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="96" CellTemplate="{StaticResource SizeCell}">
                                    <GridViewColumnHeader Tag="Size" Click="ColHeader_Click">大小</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="96" CellTemplate="{StaticResource PackedCell}">
                                    <GridViewColumnHeader Tag="Packed" Click="ColHeader_Click">压缩后</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="150" DisplayMemberBinding="{Binding ModifiedText}">
                                    <GridViewColumnHeader Tag="Modified" Click="ColHeader_Click">修改时间</GridViewColumnHeader>
                                </GridViewColumn>
                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding MethodText}">
                                    <GridViewColumnHeader Tag="Method" Click="ColHeader_Click">方式</GridViewColumnHeader>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel x:Name="EmptyHint" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="把文件或压缩包拖到这里" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="或使用上方「新建压缩包 / 打开压缩包」" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部：进度 + 状态 + 日志（常驻） -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel>
                    <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100"
                                 Background="{DynamicResource Brush.LogBg}"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 BorderThickness="0"/>
                    <DockPanel Margin="2,8,0,0">
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"
                                   Foreground="{DynamicResource Brush.SubText}"/>
                        <TextBlock x:Name="ProgressText" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="2,10,0,6">
                        <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancel" Content="取消当前操作" Click="BtnCancel_Click" MinWidth="0" Padding="10,6"/>
                            <Button x:Name="BtnCopyLog" Content="复制全部日志" Click="BtnCopyLog_Click" MinWidth="0" Padding="10,6"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="LogBox" Height="112"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource Brush.LogBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             BorderThickness="1" Padding="8,6"
                             Text="日志将在此显示。操作失败时的错误信息会常驻在这里，不会自动消失。"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
