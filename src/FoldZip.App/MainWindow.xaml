<Window x:Class="FoldZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoldZip"
        Width="1120" Height="760" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Brush.AltRow}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.HoverBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.HeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- 头部：Logo + 标题 + 版本胶囊 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource Brush.Accent}" CornerRadius="10" Padding="11,7" VerticalAlignment="Center">
                    <TextBlock Text="FZ" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FoldZip" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="6"
                                Padding="7,2" Margin="10,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="v0.1.0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="免费开源的 Windows 压缩工具 · zip / tar / gz / 7z"
                               FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource Brush.SubText}"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="BtnAbout" Content="关于" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="64"/>
        </Grid>

        <!-- 工具栏：按功能分组 -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="10"
                Padding="10" Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="BtnNew" Content="新建压缩包" Click="BtnNew_Click"/>
                <Button x:Name="BtnOpen" Content="打开压缩包" Click="BtnOpen_Click"/>
                <Button x:Name="BtnSave" Content="保存压缩包" Click="BtnSave_Click"/>
                <Border Width="1" Height="24" Background="{DynamicResource Brush.Border}" Margin="6,7,14,7"/>
                <Button x:Name="BtnAddFiles" Content="添加文件" Click="BtnAddFiles_Click"/>
                <Button x:Name="BtnAddFolder" Content="添加文件夹" Click="BtnAddFolder_Click"/>
                <Button x:Name="BtnRemove" Content="移除选中" Click="BtnRemove_Click"/>
                <Border Width="1" Height="24" Background="{DynamicResource Brush.Border}" Margin="6,7,14,7"/>
                <Button x:Name="BtnExtractAll" Content="解压到…" Click="BtnExtractAll_Click"/>
                <Button x:Name="BtnExtractSelected" Content="解压选中" Click="BtnExtractSelected_Click"/>
                <Border Width="1" Height="24" Background="{DynamicResource Brush.Border}" Margin="6,7,14,7"/>
                <Button x:Name="BtnTheme" Content="切换主题" Click="BtnTheme_Click"/>
            </WrapPanel>
        </Border>

        <!-- 中部：条目列表 + 空状态提示 -->
        <Border Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <ListView x:Name="ArchiveList"
                          SelectionMode="Extended"
                          AlternationCount="2"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="460" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="大小" Width="96" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="压缩后" Width="96" DisplayMemberBinding="{Binding PackedText}"/>
                            <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                            <GridViewColumn Header="方式" Width="130" DisplayMemberBinding="{Binding MethodText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel x:Name="EmptyHint" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="把文件或压缩包拖到这里" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="或使用上方「新建压缩包 / 打开压缩包」" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部：进度 + 状态 + 日志（常驻） -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel>
                <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100"
                             Background="{DynamicResource Brush.LogBg}"
                             Foreground="{DynamicResource Brush.Accent}"
                             BorderThickness="0"/>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Margin="2,8,0,0"
                           Foreground="{DynamicResource Brush.SubText}"/>
                <DockPanel Margin="2,10,0,6">
                    <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="取消当前操作" Click="BtnCancel_Click" MinWidth="0" Padding="10,6"/>
                        <Button x:Name="BtnCopyLog" Content="复制全部日志" Click="BtnCopyLog_Click" MinWidth="0" Padding="10,6"/>
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="LogBox" Height="112"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         Background="{DynamicResource Brush.LogBg}"
                         Foreground="{DynamicResource Brush.Text}"
                         BorderBrush="{DynamicResource Brush.Border}"
                         BorderThickness="1" Padding="8,6"
                         Text="日志将在此显示。操作失败时的错误信息会常驻在这里，不会自动消失。"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
